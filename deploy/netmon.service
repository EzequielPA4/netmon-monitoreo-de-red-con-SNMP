[Unit]
Description=netmon - monitoreo SNMP del laboratorio (TP Redes de Datos II)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netmon
Group=netmon
WorkingDirectory=/opt/netmon/app
EnvironmentFile=/etc/netmon/netmon.env
ExecStart=/opt/netmon/venv/bin/python -m netmon.web --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

# Puerto 162/udp (traps) es privilegiado (<1024): se otorga SOLO esa capacidad,
# sin ejecutar como root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Endurecimiento: el servicio solo lee archivos y abre sockets de red
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
